# ==============================================================================
# DEVELOPMENT MODE (UI/UX Preview Without API Keys)
# ==============================================================================
# To preview the UI/UX without setting up external services, use these values:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# CLERK_SECRET_KEY=sk_test_placeholder
# DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
# GOOGLE_API_KEY=placeholder
# PINECONE_API_KEY=placeholder
#
# This activates development mode where:
# - Authentication is bypassed
# - Mock user data is displayed
# - All pages are accessible
# - Perfect for UI/UX review and design work
# ==============================================================================

# Clerk Authentication
# Get keys at: https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# Database (Supabase PostgreSQL)
# Get connection string at: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://user:password@host:5432/database

# Google Gemini API
# Get key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# Pinecone Vector Database
# Get free tier at: https://www.pinecone.io
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=mechassist-vectors

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Prisma
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# Optional: Analytics & Monitoring
# NEXT_PUBLIC_POSTHOG_KEY=...
# SENTRY_DSN=...
